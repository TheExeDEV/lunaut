{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Luau",
  "scopeName": "source.luau",
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#interpolated" },
    { "include": "#declaration" },
    { "include": "#keyword" },
    { "include": "#constant" },
    { "include": "#number" },
    { "include": "#function-call" },
    { "include": "#operator" }
  ],
  "repository": {
    "comment": {
      "patterns": [
        { "name": "comment.block.luau", "begin": "--\\[(=*)\\[", "end": "\\]\\1\\]" },
        { "name": "keyword.other.directive.luau", "match": "--!\\w+.*$" },
        { "name": "comment.line.double-dash.luau", "match": "--.*$" }
      ]
    },
    "string": {
      "patterns": [
        { "name": "string.quoted.double.luau", "begin": "\"", "end": "\"|$", "patterns": [{ "include": "#escape" }] },
        { "name": "string.quoted.single.luau", "begin": "'", "end": "'|$", "patterns": [{ "include": "#escape" }] },
        { "name": "string.quoted.other.multiline.luau", "begin": "\\[(=*)\\[", "end": "\\]\\1\\]" }
      ]
    },
    "interpolated": {
      "name": "string.interpolated.luau",
      "begin": "`",
      "end": "`",
      "patterns": [
        { "include": "#escape" },
        {
          "name": "meta.template.expression.luau",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": { "0": { "name": "punctuation.definition.interpolation.begin.luau" } },
          "endCaptures": { "0": { "name": "punctuation.definition.interpolation.end.luau" } },
          "patterns": [{ "include": "$self" }]
        }
      ]
    },
    "escape": {
      "name": "constant.character.escape.luau",
      "match": "\\\\(?:[abfnrtvz\\\\\"'`{]|\\d{1,3}|x[0-9a-fA-F]{2}|u\\{[0-9a-fA-F]+\\})"
    },
    "declaration": {
      "patterns": [
        {
          "match": "\\b(export\\s+)?(type)\\s+(function\\s+)?([A-Za-z_]\\w*)",
          "captures": {
            "1": { "name": "storage.modifier.export.luau" },
            "2": { "name": "storage.type.type.luau" },
            "3": { "name": "storage.type.function.luau" },
            "4": { "name": "entity.name.type.luau" }
          }
        },
        {
          "match": "\\b(declare)\\s+(extern\\s+type|class)\\s+([A-Za-z_]\\w*)(?:\\s+(extends)\\s+([A-Za-z_]\\w*))?",
          "captures": {
            "1": { "name": "storage.modifier.declare.luau" },
            "2": { "name": "storage.type.class.luau" },
            "3": { "name": "entity.name.type.class.luau" },
            "4": { "name": "storage.modifier.extends.luau" },
            "5": { "name": "entity.other.inherited-class.luau" }
          }
        },
        {
          "match": "\\b(function)\\s+([A-Za-z_][\\w.:]*)",
          "captures": {
            "1": { "name": "storage.type.function.luau" },
            "2": { "name": "entity.name.function.luau" }
          }
        },
        {
          "match": ":\\s*([A-Za-z_]\\w*)",
          "captures": { "1": { "name": "support.type.luau" } }
        }
      ]
    },
    "keyword": {
      "patterns": [
        { "name": "keyword.control.luau", "match": "\\b(and|break|continue|do|else|elseif|end|for|if|in|not|or|repeat|return|then|until|while)\\b" },
        { "name": "storage.modifier.luau", "match": "\\b(local|const|function|declare|export)\\b" },
        { "name": "keyword.operator.typeof.luau", "match": "\\btypeof\\b" }
      ]
    },
    "constant": {
      "patterns": [
        { "name": "constant.language.luau", "match": "\\b(nil|true|false)\\b" },
        { "name": "variable.language.self.luau", "match": "\\bself\\b" },
        { "name": "support.function.builtin.luau", "match": "\\b(assert|error|getmetatable|ipairs|next|pairs|pcall|print|rawequal|rawget|rawlen|rawset|require|select|setmetatable|tonumber|tostring|type|typeof|unpack|xpcall)\\b" },
        { "name": "support.constant.library.luau", "match": "\\b(bit32|buffer|coroutine|debug|math|os|string|table|utf8|vector|game|workspace|script|Enum)\\b" }
      ]
    },
    "number": {
      "patterns": [
        { "name": "constant.numeric.hex.luau", "match": "\\b0[xX][0-9a-fA-F_]+\\b" },
        { "name": "constant.numeric.binary.luau", "match": "\\b0[bB][01_]+\\b" },
        { "name": "constant.numeric.decimal.luau", "match": "\\b\\d[\\d_]*(\\.[\\d_]+)?([eE][+-]?\\d+)?\\b" }
      ]
    },
    "function-call": {
      "match": "\\b([A-Za-z_]\\w*)\\s*(?=[({\"'`])",
      "captures": { "1": { "name": "entity.name.function.call.luau" } }
    },
    "operator": {
      "patterns": [
        { "name": "keyword.operator.luau", "match": "(\\+=|-=|\\*=|/=|//=|%=|\\^=|\\.\\.=|==|~=|<=|>=|->|\\.\\.\\.|\\.\\.|//|[+\\-*/%^#<>=?|&])" }
      ]
    }
  }
}
