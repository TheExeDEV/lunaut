#!/bin/sh
set `# <#` >/dev/null 2>&1

set -eu

repository="${LUNAUT_REPOSITORY:-TheExeDEV/lunaut}"
script_url="https://raw.githubusercontent.com/$repository/main/installers/install"
version="${LUNAUT_VERSION:-latest}"
install_dir="${LUNAUT_INSTALL_DIR:-$HOME/.lunaut/bin}"
config_home="${XDG_CONFIG_HOME:-$HOME/.config}"

case "$(uname -s)" in
	Linux) system="linux" ;;
	Darwin) system="osx" ;;
	MINGW* | MSYS* | CYGWIN*)
		powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "irm $script_url | iex"
		exit $?
		;;
	*) echo "lunaut does not support $(uname -s) yet." >&2; exit 1 ;;
esac

case "$(uname -m)" in
	x86_64 | amd64) architecture="x64" ;;
	arm64 | aarch64) architecture="arm64" ;;
	*) echo "lunaut does not support the $(uname -m) processor yet." >&2; exit 1 ;;
esac

asset="lunaut-$system-$architecture"

if [ "$version" = "latest" ]; then
	base_url="https://github.com/$repository/releases/latest/download"
	source_url="https://raw.githubusercontent.com/$repository/main"
else
	base_url="https://github.com/$repository/releases/download/v${version#v}"
	source_url="https://raw.githubusercontent.com/$repository/v${version#v}"
fi

if [ "$system" = "osx" ]; then
	zed_data="$HOME/Library/Application Support/Zed"
else
	zed_data="${XDG_DATA_HOME:-$HOME/.local/share}/zed"
fi

download() {
	if command -v curl >/dev/null 2>&1; then
		curl --fail --location --progress-bar --retry 3 --connect-timeout 15 "$1" --output "$2"
	elif command -v wget >/dev/null 2>&1; then
		wget --quiet --show-progress --tries=3 --timeout=15 "$1" --output-document="$2"
	else
		echo "Install curl or wget first." >&2
		exit 1
	fi
}

find_command() {
	for candidate in "$@"; do
		case "$candidate" in
			/*)
				if [ -x "$candidate" ]; then
					echo "$candidate"
					return 0
				fi
				;;
			*)
				if command -v "$candidate" >/dev/null 2>&1; then
					command -v "$candidate"
					return 0
				fi
				;;
		esac
	done

	return 1
}

targets=""
count=0

add_target() {
	count=$((count + 1))
	targets="$targets$count|$1|$2|$3|$4
"
}

add_code_editor() {
	key="$1"
	name="$2"
	shift 2

	if found="$(find_command "$@")"; then
		add_target "$key" vscode "$name" "$found"
	fi
}

add_code_editor code "VS Code" code "/Applications/Visual Studio Code.app/Contents/Resources/app/bin/code"
add_code_editor code-insiders "VS Code Insiders" code-insiders "/Applications/Visual Studio Code - Insiders.app/Contents/Resources/app/bin/code-insiders"
add_code_editor cursor "Cursor" cursor "/Applications/Cursor.app/Contents/Resources/app/bin/cursor"
add_code_editor windsurf "Windsurf" windsurf "/Applications/Windsurf.app/Contents/Resources/app/bin/windsurf"
add_code_editor codium "VSCodium" codium "/Applications/VSCodium.app/Contents/Resources/app/bin/codium"

if find_command zed zeditor >/dev/null || [ -d "/Applications/Zed.app" ] || [ -d "$zed_data" ]; then
	add_target zed zed "Zed" ""
fi

if found="$(find_command nvim)"; then
	add_target nvim nvim "Neovim" "$found"
fi

if found="$(find_command hx helix)"; then
	add_target helix helix "Helix" "$found"
fi

add_target path path "Terminal (the lunaut command on PATH)" ""

can_ask() {
	[ -t 1 ] && (exec </dev/tty) 2>/dev/null
}

is_number() {
	case "$1" in
		'' | *[!0-9]*) return 1 ;;
	esac

	[ "$1" -ge 1 ] && [ "$1" -le "$count" ]
}

selected=""

select_by_keys() {
	for wanted in $(echo "$1" | tr ',' ' '); do
		while IFS='|' read -r index key kind name command; do
			if [ -n "$index" ] && { [ "$wanted" = "all" ] || [ "$wanted" = "$key" ]; }; then
				selected="$selected $index "
			fi
		done <<EOF
$targets
EOF
	done
}

if [ -n "${LUNAUT_EDITORS:-}" ]; then
	select_by_keys "$LUNAUT_EDITORS"
elif can_ask; then
	echo "Where should lunaut be installed?"

	while IFS='|' read -r index key kind name command; do
		if [ -n "$index" ]; then
			echo "  $index) $name"
		fi
	done <<EOF
$targets
EOF

	while :; do
		printf 'Type numbers separated by spaces, or press Enter for all: '
		answer=""
		read -r answer </dev/tty || true
		answer="$(echo "$answer" | tr ',' ' ')"
		selected=""
		valid=1

		if [ -z "$answer" ] || [ "$answer" = "all" ]; then
			select_by_keys all
			break
		fi

		for token in $answer; do
			if is_number "$token"; then
				selected="$selected $token "
			else
				valid=0
			fi
		done

		if [ "$valid" -eq 1 ] && [ -n "$selected" ]; then
			break
		fi

		echo "Use the numbers from the list, for example: 1 3"
	done
else
	select_by_keys all
fi

if [ -n "${LUNAUT_NO_EXTENSION:-}" ]; then
	while IFS='|' read -r index key kind name command; do
		if [ "$kind" = "vscode" ]; then
			selected="$(echo "$selected" | sed "s/ $index / /g")"
		fi
	done <<EOF
$targets
EOF
fi

is_selected() {
	case "$selected" in
		*" $1 "*) return 0 ;;
	esac

	return 1
}

has_kind() {
	while IFS='|' read -r index key kind name command; do
		if [ "$kind" = "$1" ] && is_selected "$index"; then
			return 0
		fi
	done <<EOF
$targets
EOF

	return 1
}

if [ -z "$(echo "$selected" | tr -d ' ')" ]; then
	echo "Nothing selected, nothing was installed."
	exit 0
fi

notes=""
needs_server=0

for kind in zed nvim helix path; do
	if has_kind "$kind"; then
		needs_server=1
	fi
done

if [ "$needs_server" -eq 1 ]; then
	mkdir -p "$install_dir"
	target="$install_dir/lunaut.download"

	echo "Downloading lunaut for $system $architecture"
	download "$base_url/$asset" "$target"

	chmod +x "$target"
	mv "$target" "$install_dir/lunaut"
fi

if has_kind vscode; then
	mkdir -p "$install_dir"
	extension="$install_dir/lunaut.vsix"

	echo "Downloading the extension"
	download "$base_url/lunaut.vsix" "$extension"

	while IFS='|' read -r index key kind name command; do
		if [ "$kind" != "vscode" ] || ! is_selected "$index"; then
			continue
		fi

		if "$command" --install-extension "$extension" --force >/dev/null 2>&1; then
			echo "Installed the extension in $name"
		else
			echo "Could not install the extension in $name" >&2
		fi
	done <<EOF
$targets
EOF

	rm -f "$extension"
fi

if has_kind nvim; then
	plugin_dir="$config_home/nvim/plugin"
	mkdir -p "$plugin_dir"
	download "$source_url/editors/neovim/lunaut.lua" "$plugin_dir/lunaut.lua"
	echo "Installed the Neovim config in $plugin_dir/lunaut.lua"
fi

if has_kind helix; then
	helix_config="$config_home/helix/languages.toml"

	if [ -f "$helix_config" ]; then
		notes="${notes}Helix: $helix_config already exists, merge $source_url/editors/helix/languages.toml into it
"
	else
		mkdir -p "$(dirname "$helix_config")"
		download "$source_url/editors/helix/languages.toml" "$helix_config"
		echo "Installed the Helix config in $helix_config"
	fi
fi

if has_kind zed; then
	notes="${notes}Zed: open Extensions (zed: extensions), search for Lunaut and install it; it uses the lunaut on PATH
"
fi

path_line="export PATH=\"$install_dir:\$PATH\""

add_to_path() {
	file="$1"

	if [ -f "$file" ] && grep -qF "$install_dir" "$file"; then
		return
	fi

	printf '\n# lunaut\n%s\n' "$path_line" >> "$file"
	echo "Added lunaut to PATH in $file"
}

if [ "$needs_server" -eq 1 ] && [ -z "${LUNAUT_NO_PATH:-}" ]; then
	case ":$PATH:" in
		*":$install_dir:"*) ;;
		*)
			shell_name="$(basename "${SHELL:-sh}")"

			if [ -f "$HOME/.bashrc" ] || [ "$shell_name" = "bash" ]; then
				add_to_path "$HOME/.bashrc"
			fi

			if [ -f "$HOME/.zshrc" ] || [ "$shell_name" = "zsh" ]; then
				add_to_path "$HOME/.zshrc"
			fi

			add_to_path "$HOME/.profile"

			if [ -d "$config_home/fish" ]; then
				mkdir -p "$config_home/fish/conf.d"
				echo "fish_add_path $install_dir" > "$config_home/fish/conf.d/lunaut.fish"
			fi

			notes="${notes}Open a new terminal, or run this to use lunaut right now: $path_line
"
			;;
	esac
fi

if [ -n "$notes" ]; then
	echo
	printf '%s' "$notes"
fi

if [ "$needs_server" -eq 1 ]; then
	"$install_dir/lunaut" --version
fi

exit 0
#>

& {
	$ErrorActionPreference = "Stop"
	$ProgressPreference = "SilentlyContinue"

	$repository = if ($env:LUNAUT_REPOSITORY) { $env:LUNAUT_REPOSITORY } else { "TheExeDEV/lunaut" }
	$scriptUrl = "https://raw.githubusercontent.com/$repository/main/installers/install"

	if ($PSVersionTable.PSEdition -eq "Core" -and -not $IsWindows) {
		& sh -c "curl -fsSL $scriptUrl | sh"
		return
	}

	[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12

	$version = if ($env:LUNAUT_VERSION) { $env:LUNAUT_VERSION } else { "latest" }
	$installDir = if ($env:LUNAUT_INSTALL_DIR) { $env:LUNAUT_INSTALL_DIR } else { Join-Path $env:LOCALAPPDATA "lunaut\bin" }
	$architecture = if ($env:PROCESSOR_ARCHITECTURE -eq "ARM64" -or $env:PROCESSOR_ARCHITEW6432 -eq "ARM64") { "arm64" } else { "x64" }
	$asset = "lunaut-win-$architecture.exe"

	if ($version -eq "latest") {
		$baseUrl = "https://github.com/$repository/releases/latest/download"
		$sourceUrl = "https://raw.githubusercontent.com/$repository/main"
	} else {
		$baseUrl = "https://github.com/$repository/releases/download/v$($version.TrimStart('v'))"
		$sourceUrl = "https://raw.githubusercontent.com/$repository/v$($version.TrimStart('v'))"
	}

	function Get-File($url, $output) {
		for ($attempt = 1; $attempt -le 3; $attempt++) {
			try {
				Invoke-WebRequest -Uri $url -OutFile $output -UseBasicParsing -TimeoutSec 120
				return
			} catch {
				if ($attempt -eq 3) {
					throw "Could not download $url. Check your internet connection and try again."
				}

				Start-Sleep -Seconds (2 * $attempt)
			}
		}
	}

	function Find-Command($names, $paths) {
		foreach ($name in $names) {
			$found = Get-Command $name -CommandType Application -ErrorAction SilentlyContinue | Select-Object -First 1

			if ($found) {
				return $found.Source
			}
		}

		foreach ($path in $paths) {
			if ($path -and (Test-Path -LiteralPath $path)) {
				return $path
			}
		}

		return $null
	}

	$programs = Join-Path $env:LOCALAPPDATA "Programs"
	$targets = New-Object System.Collections.ArrayList

	$codeEditors = @(
		@{ Key = "code"; Name = "VS Code"; Names = @("code.cmd", "code"); Paths = @("$programs\Microsoft VS Code\bin\code.cmd", "$env:ProgramFiles\Microsoft VS Code\bin\code.cmd") },
		@{ Key = "code-insiders"; Name = "VS Code Insiders"; Names = @("code-insiders.cmd"); Paths = @("$programs\Microsoft VS Code Insiders\bin\code-insiders.cmd", "$env:ProgramFiles\Microsoft VS Code Insiders\bin\code-insiders.cmd") },
		@{ Key = "cursor"; Name = "Cursor"; Names = @("cursor.cmd"); Paths = @("$programs\cursor\resources\app\bin\cursor.cmd") },
		@{ Key = "windsurf"; Name = "Windsurf"; Names = @("windsurf.cmd"); Paths = @("$programs\Windsurf\bin\windsurf.cmd") },
		@{ Key = "codium"; Name = "VSCodium"; Names = @("codium.cmd"); Paths = @("$programs\VSCodium\bin\codium.cmd", "$env:ProgramFiles\VSCodium\bin\codium.cmd") }
	)

	foreach ($editor in $codeEditors) {
		$command = Find-Command $editor.Names $editor.Paths

		if ($command) {
			[void]$targets.Add(@{ Key = $editor.Key; Kind = "vscode"; Name = $editor.Name; Command = $command })
		}
	}

	if ((Find-Command @("zed") @("$programs\Zed\Zed.exe")) -or (Test-Path -LiteralPath (Join-Path $env:LOCALAPPDATA "Zed"))) {
		[void]$targets.Add(@{ Key = "zed"; Kind = "zed"; Name = "Zed"; Command = $null })
	}

	$nvim = Find-Command @("nvim") @("$env:ProgramFiles\Neovim\bin\nvim.exe")

	if ($nvim) {
		[void]$targets.Add(@{ Key = "nvim"; Kind = "nvim"; Name = "Neovim"; Command = $nvim })
	}

	$helix = Find-Command @("hx") @()

	if ($helix) {
		[void]$targets.Add(@{ Key = "helix"; Kind = "helix"; Name = "Helix"; Command = $helix })
	}

	[void]$targets.Add(@{ Key = "path"; Kind = "path"; Name = "Terminal (the lunaut command on PATH)"; Command = $null })

	$selected = @()

	if ($env:LUNAUT_EDITORS) {
		$wanted = @($env:LUNAUT_EDITORS -split '[,\s]+' | Where-Object { $_ -ne "" })
		$selected = @($targets | Where-Object { $wanted -contains "all" -or $wanted -contains $_.Key })
	} elseif ([Environment]::UserInteractive -and -not [Console]::IsInputRedirected) {
		Write-Host "Where should lunaut be installed?"

		for ($index = 0; $index -lt $targets.Count; $index++) {
			Write-Host "  $($index + 1)) $($targets[$index].Name)"
		}

		while ($true) {
			$answer = (Read-Host "Type numbers separated by spaces, or press Enter for all").Trim()

			if ($answer -eq "" -or $answer -eq "all") {
				$selected = @($targets)
				break
			}

			$tokens = @($answer -split '[,\s]+' | Where-Object { $_ -ne "" })
			$numbers = @($tokens | Where-Object { $_ -match '^\d+$' -and [int]$_ -ge 1 -and [int]$_ -le $targets.Count } | ForEach-Object { [int]$_ } | Select-Object -Unique)

			if ($numbers.Count -gt 0 -and $numbers.Count -eq @($tokens | Select-Object -Unique).Count) {
				$selected = @($numbers | ForEach-Object { $targets[$_ - 1] })
				break
			}

			Write-Host "Use the numbers from the list, for example: 1 3"
		}
	} else {
		$selected = @($targets)
	}

	if ($env:LUNAUT_NO_EXTENSION) {
		$selected = @($selected | Where-Object { $_.Kind -ne "vscode" })
	}

	if ($selected.Count -eq 0) {
		Write-Host "Nothing selected, nothing was installed."
		return
	}

	$kinds = @($selected | ForEach-Object { $_.Kind })
	$needsServer = @($kinds | Where-Object { @("zed", "nvim", "helix", "path") -contains $_ }).Count -gt 0
	$notes = New-Object System.Collections.ArrayList
	$target = Join-Path $installDir "lunaut.exe"

	New-Item -ItemType Directory -Force -Path $installDir | Out-Null

	if ($needsServer) {
		$download = "$target.download"

		Write-Host "Downloading lunaut for windows $architecture"
		Get-File "$baseUrl/$asset" $download
		Move-Item -Path $download -Destination $target -Force
	}

	if ($kinds -contains "vscode") {
		$extension = Join-Path $installDir "lunaut.vsix"

		Write-Host "Downloading the extension"
		Get-File "$baseUrl/lunaut.vsix" $extension

		foreach ($editor in @($selected | Where-Object { $_.Kind -eq "vscode" })) {
			& $editor.Command --install-extension $extension --force 2>$null | Out-Null

			if ($LASTEXITCODE -eq 0) {
				Write-Host "Installed the extension in $($editor.Name)"
			} else {
				Write-Host "Could not install the extension in $($editor.Name)"
			}
		}

		Remove-Item -LiteralPath $extension -Force -ErrorAction SilentlyContinue
	}

	if ($kinds -contains "nvim") {
		$pluginDir = Join-Path $env:LOCALAPPDATA "nvim\plugin"
		New-Item -ItemType Directory -Force -Path $pluginDir | Out-Null
		Get-File "$sourceUrl/editors/neovim/lunaut.lua" (Join-Path $pluginDir "lunaut.lua")
		Write-Host "Installed the Neovim config in $pluginDir\lunaut.lua"
	}

	if ($kinds -contains "helix") {
		$helixConfig = Join-Path $env:APPDATA "helix\languages.toml"

		if (Test-Path -LiteralPath $helixConfig) {
			[void]$notes.Add("Helix: $helixConfig already exists, merge $sourceUrl/editors/helix/languages.toml into it")
		} else {
			New-Item -ItemType Directory -Force -Path (Split-Path $helixConfig) | Out-Null
			Get-File "$sourceUrl/editors/helix/languages.toml" $helixConfig
			Write-Host "Installed the Helix config in $helixConfig"
		}
	}

	if ($kinds -contains "zed") {
		[void]$notes.Add("Zed: open Extensions (zed: extensions), search for Lunaut and install it; it uses the lunaut on PATH")
	}

	if ($needsServer -and -not $env:LUNAUT_NO_PATH) {
		$userPath = [Environment]::GetEnvironmentVariable("Path", "User")
		$entries = @()

		if ($userPath) {
			$entries = @($userPath.Split(";") | Where-Object { $_ -ne "" })
		}

		if ($entries -notcontains $installDir) {
			[Environment]::SetEnvironmentVariable("Path", (@($entries) + $installDir) -join ";", "User")
			Write-Host "Added lunaut to PATH. Other open terminals need a restart to see it."
		}

		if (($env:Path.Split(";")) -notcontains $installDir) {
			$env:Path = "$env:Path;$installDir"
		}
	}

	if ((Test-Path -LiteralPath $installDir) -and -not (Get-ChildItem -LiteralPath $installDir -Force | Select-Object -First 1)) {
		Remove-Item -LiteralPath $installDir -Force
	}

	if ($notes.Count -gt 0) {
		Write-Host ""
		$notes | ForEach-Object { Write-Host $_ }
	}

	if ($needsServer) {
		& $target --version
	}
}
